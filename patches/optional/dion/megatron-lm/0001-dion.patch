+        """Largest difference over the instances of a checksum of this rank's matrices."""
+        items = self._items()
+        device = items[0][2].device if items else torch.device("cuda")
+        s = torch.zeros(2, dtype=torch.float64, device=device)
+        for _, _, p, _ in items:
+            s[0] += p.double().sum()
+            s[1] += p.double().square().sum()
