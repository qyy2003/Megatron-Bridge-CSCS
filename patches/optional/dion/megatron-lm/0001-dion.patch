new file mode 100644
index 0000000..db494dc
--- /dev/null
+++ b/megatron/core/optimizer/dion.py
@@ -0,0 +1,380 @@
+"""Dion for the layer-wise distributed optimizer, with compressed sync across optimizer instances.
+
+Dion: K. Ahn, B. Xu, N. Abreu, J. Langford, "Dion: Distributed Orthonormalized Updates",
+arXiv:2504.05295. Written from the paper's algorithm for Megatron-Core's shard-aligned layer-wise
+optimizer (every rank holds whole matrices); not derived from the authors' package.
+
+Per weight matrix X (m x n) with rank r, momentum M (m x n) and right factor Q (n x r):
+
+    B = M + G
+    P = orthonormalize(B Q)              m x r
+    R = B^T P                            n x r
+    M = B - (1 - mu) P R^T               error feedback: what the rank-r update did not take
+    Q = R / ||R||_columns
+    X = X (1 - lr wd) - lr scale P Q^T
+
+Optimizer instances (ddp.num_distributed_optimizer_instances = N > 1, launch.sh GLOBAL_DP). Inside
+an instance DDP reduce-scatters the gradients as usual, so a rank holds its instance's gradient of
+the whole matrices it owns. With ddp.layer_wise_skip_inter_instance_grad_sync these gradients are
+not all-reduced across instances: instance i holds g_i, and sum_i g_i is the global mean gradient
+(DDP pre-scales by 1 / total DP size, or with averaging collectives divides each instance's mean by
+N in place of the skipped all-reduce). Each instance keeps its own momentum M_i. Only B_i Q and
+B_i^T P are summed over the inter-instance group, and each instance subtracts (1 - mu) P R^T / N.
+Then sum_i M_i is exactly the momentum of single-instance Dion on the global mean gradient, and P,
+Q and the weight update, computed from summed quantities only, are the same on every instance.
+Cross-instance traffic per matrix: (m + n) r values instead of m n.
+
+Only sum_i M_i enters the algorithm, so the momenta may be replaced by their mean at any time
+without changing it. That is done before a checkpoint is saved: the instances then hold identical
+state and only instance 0 writes it, as for every other optimizer. Q is a warm start for the power
+iteration and not saved; it is re-initialized after a resume (same seed on every instance).
+
+Speed: matrices of equal shape (and param group) form a run whose momenta and Q live in stacked
+tensors (``state["momentum_buffer"]`` are views of the stack), so the products are batched; P is
+orthonormalized by Cholesky QR (two passes, fp64), with Householder QR only for rank-deficient
+matrices; element-wise work uses multi-tensor ops.
+"""
+
+import logging
+import math
+from typing import Dict, List, Optional, Tuple
+
+import torch
+from torch.optim.optimizer import Optimizer
+
+logger = logging.getLogger(__name__)
+
+_COMM_DTYPES = {"fp32": torch.float32, "bf16": torch.bfloat16}
+
+
+def dion_scale_factor(size_out: int, size_in: int, mode: str) -> float:
+    """Update scale, with the conventions of emerging_optimizers' Muon (``get_muon_scale_factor``).
+
+    With "spectral" a full-rank Dion update has the RMS of a Muon update, since at full rank and a
+    converged power iteration P Q^T is the polar factor U V^T that Muon's Newton-Schulz computes.
+    """
+    if mode == "spectral":
+        return max(size_out, size_in) ** 0.5
+    if mode == "shape_scaling":
+        return max(1.0, size_out / size_in) ** 0.5
+    if mode == "unit_rms_norm":
+        return (size_out / size_in) ** 0.5
+    raise ValueError(f"Invalid Dion scale mode: {mode}")
+
+
+def orthonormalize(p: torch.Tensor) -> torch.Tensor:
+    """Orthonormal columns spanning those of each p[i] (batch k x m x r, m >= r), fp32 result.
+
+    Cholesky QR, two passes in fp64 (~40x faster than batched Householder QR here). Matrices whose
+    Gram matrix is singular (e.g. all zero, or an expert gradient of rank < r) or whose result is
+    not orthonormal to 1e-4 fall back to Householder QR. Column signs may differ from
+    Householder's; Dion is invariant to them.
+    """
+    x = p.double()
+    eye = torch.eye(p.shape[2], dtype=x.dtype, device=x.device)
+    ok = torch.ones(p.shape[0], dtype=torch.bool, device=p.device)
+    for _ in range(2):
+        chol, info = torch.linalg.cholesky_ex(x.mT @ x)
+        ok &= info == 0
+        chol = torch.where(ok[:, None, None], chol, eye)
+        x = torch.linalg.solve_triangular(chol, x.mT, upper=False).mT
+    ok &= ((x.mT @ x - eye).abs().amax(dim=(1, 2)) < 1e-4) & torch.isfinite(x).all(dim=(1, 2))
+    out = x.float()
+    if not bool(ok.all()):
+        bad = (~ok).nonzero().flatten()
+        out[bad] = torch.linalg.qr(p[bad].float(), mode="reduced")[0]
+    return out
+
+
+class Dion(Optimizer):
+    """Dion for 2-D weight matrices held whole on this rank (TP = expert TP = 1).
+
+    Args:
+        params: parameters or param groups (fp32 main params; each 2-D).
+        lr, weight_decay: as for Muon (decoupled weight decay); updated by the LR scheduler.
+        mu: momentum / error-feedback factor.
+        rank_fraction: rank r = rank_fraction x min(m, n), rounded up to ``rank_multiple_of``.
+        scale_mode, extra_scale_factor: update scale (see :func:`dion_scale_factor`).
+        epsilon: added to the column norms of R.
+        comm_dtype: "bf16" or "fp32", dtype of P and R when summed across instances.
+        inter_instance_group: the group of this rank's peers in the other optimizer instances
+            (None or size 1: no cross-instance reduction; the gradients are already global).
+        max_comm_bucket_numel: P + R values per bucket; buckets bound the memory of the
+            factors and give 2 collectives per bucket and step.
+        q_seed: seed of the initial Q (per matrix: q_seed + its position on this rank).
+        sync_check_interval: every this many steps, compare a checksum of the parameters across
+            instances and log the largest difference (0 = off).
+    """
+
+    def __init__(
+        self,
+        params,
+        lr: float = 3e-4,
+        mu: float = 0.95,
+        weight_decay: float = 0.0,
+        rank_fraction: float = 0.25,
+        rank_multiple_of: int = 8,
+        scale_mode: str = "spectral",
+        extra_scale_factor: float = 1.0,
+        epsilon: float = 1e-8,
+        comm_dtype: str = "bf16",
+        inter_instance_group: Optional[torch.distributed.ProcessGroup] = None,
+        max_comm_bucket_numel: int = 2**27,
+        q_seed: int = 1234,
+        sync_check_interval: int = 0,
+    ) -> None:
+        if not 0.0 < rank_fraction <= 1.0:
+            raise ValueError(f"rank_fraction must be in (0, 1], got {rank_fraction}")
+        if not 0.0 <= mu < 1.0:
+            raise ValueError(f"mu must be in [0, 1), got {mu}")
+        if comm_dtype not in _COMM_DTYPES:
+            raise ValueError(f"comm_dtype must be one of {sorted(_COMM_DTYPES)}, got {comm_dtype}")
+        dion_scale_factor(2, 1, scale_mode)  # validate
+        super().__init__(params, dict(lr=lr, mu=mu, weight_decay=weight_decay))
+        for group in self.param_groups:
+            for p in group["params"]:
+                if p.dim() != 2:
+                    raise ValueError(f"Dion handles 2-D matrices only, got shape {tuple(p.shape)}")
+        self.rank_fraction = rank_fraction
+        self.rank_multiple_of = max(1, rank_multiple_of)
+        self.scale_mode = scale_mode
+        self.extra_scale_factor = extra_scale_factor
+        self.epsilon = epsilon
+        self.comm_dtype = _COMM_DTYPES[comm_dtype]
+        self.max_comm_bucket_numel = max_comm_bucket_numel
+        self.q_seed = q_seed
+        self.sync_check_interval = sync_check_interval
+        self.inter_group = inter_instance_group
+        self.num_instances = 1
+        if inter_instance_group is not None:
+            self.num_instances = torch.distributed.get_world_size(inter_instance_group)
+            if self.num_instances == 1:
+                self.inter_group = None
+        # Per run of equal-shape matrices: stacked momentum and Q. Q is kept outside
+        # ``self.state``: checkpoints map every state tensor onto the parameter's shape, which Q
+        # (n x r) does not have. ``_q`` maps a param to its Q (a view of the stack).
+        self._runs: Dict[Tuple[int, ...], dict] = {}
+        self._q: Dict[torch.Tensor, torch.Tensor] = {}
+        self._num_steps = 0
+
+    # ------------------------------------------------------------------ helpers
+    def rank_for(self, p: torch.Tensor) -> int:
+        """Rank r of the update of matrix ``p``."""
+        k = min(p.shape)
+        r = math.ceil(self.rank_fraction * k)
+        r = math.ceil(r / self.rank_multiple_of) * self.rank_multiple_of
+        return max(1, min(k, r))
+
+    def _init_group(self, group: dict, skip_non_grad_params: bool = True) -> None:
+        """Create the momentum (also for parameters without gradients, for checkpoint templates)."""
+        for p in group["params"]:
+            if skip_non_grad_params and p.grad is None:
+                continue
+            state = self.state[p]
+            if "momentum_buffer" not in state:
+                state["momentum_buffer"] = torch.zeros_like(p, dtype=torch.float32)
+
+    def _all_reduce(self, t: torch.Tensor) -> None:
+        if self.inter_group is not None:
+            torch.distributed.all_reduce(t, op=torch.distributed.ReduceOp.SUM, group=self.inter_group)
+
+    def _items(self) -> List[Tuple[int, int, torch.Tensor, dict]]:
+        """(position on this rank, group position, param, group); the same on every instance."""
+        items, index = [], 0
+        for gidx, group in enumerate(self.param_groups):
+            for p in group["params"]:
+                items.append((index, gidx, p, group))
+                index += 1
+        return items
+
+    def _check_alignment(self, items) -> None:
+        """Peers in the other instances must own the same matrices in the same order."""
+        sig = torch.zeros(3, dtype=torch.float64, device=items[0][2].device if items else "cuda")
+        for index, _, p, _ in items:
+            sig[0] += 1
+            sig[1] += p.numel()
+            sig[2] += (index + 1) * (p.shape[0] * 7919 + p.shape[1])
+        hi, lo = sig.clone(), sig.clone()
+        torch.distributed.all_reduce(hi, op=torch.distributed.ReduceOp.MAX, group=self.inter_group)
+        torch.distributed.all_reduce(lo, op=torch.distributed.ReduceOp.MIN, group=self.inter_group)
+        if not torch.equal(hi, lo):
+            raise RuntimeError(
+                "Dion: the matrices owned by this rank differ from those of its peers in the other "
+                f"optimizer instances (signature here {sig.tolist()}, max {hi.tolist()}, min {lo.tolist()})"
+            )
+
+    def _plan(self, items) -> List[List[List[tuple]]]:
+        """Buckets of runs: a run = consecutive items of equal (shape, group); deterministic."""
+        order = sorted(items, key=lambda it: (it[2].shape[0], it[2].shape[1], it[1], it[0]))
+        runs: List[List[tuple]] = []
+        for item in order:
+            key = (item[2].shape[0], item[2].shape[1], item[1])
+            if runs and (runs[-1][0][2].shape[0], runs[-1][0][2].shape[1], runs[-1][0][1]) == key:
+                runs[-1].append(item)
+            else:
+                runs.append([item])
+        buckets, bucket, numel = [], [], 0
+        for run in runs:
+            m, n = run[0][2].shape
+            r = self.rank_for(run[0][2])
+            # split a run that alone exceeds the bucket size
+            per = max(1, self.max_comm_bucket_numel // ((m + n) * r))
+            for start in range(0, len(run), per):
+                piece = run[start : start + per]
+                size = len(piece) * (m + n) * r
+                if bucket and numel + size > self.max_comm_bucket_numel:
+                    buckets.append(bucket)
+                    bucket, numel = [], 0
+                bucket.append(piece)
+                numel += size
+        if bucket:
+            buckets.append(bucket)
+        return buckets
+
+    def _run_storage(self, run) -> dict:
+        """Stacked momentum and Q of a run; (re)built when the state tensors are not its views
+        (first step, or after load_state_dict replaced them)."""
+        key = tuple(it[0] for it in run)
+        params = [it[2] for it in run]
+        st = self._runs.get(key)
+        m, n = params[0].shape
+        r = self.rank_for(params[0])
+        if st is None:
+            q = torch.empty(len(run), n, r, device=params[0].device, dtype=torch.float32)
+            for i, (index, _, p, _) in enumerate(run):
+                gen = torch.Generator(device=p.device)
+                gen.manual_seed(self.q_seed + index)
+                q[i] = torch.randn(n, r, device=p.device, dtype=torch.float32, generator=gen)
+            q /= q.norm(dim=1, keepdim=True)
+            st = {"M": None, "Q": q}
+            self._runs[key] = st
+            for i, p in enumerate(params):
+                self._q[p] = q[i]
+        stack = st["M"]
+        views_ok = stack is not None and all(
+            self.state[p].get("momentum_buffer") is not None
+            and self.state[p]["momentum_buffer"].data_ptr() == stack[i].data_ptr()
+            for i, p in enumerate(params)
+        )
+        if not views_ok:
+            stack = torch.zeros(len(run), m, n, device=params[0].device, dtype=torch.float32)
+            for i, p in enumerate(params):
+                old = self.state[p].get("momentum_buffer")
+                if old is not None:
+                    stack[i].copy_(old)
+                self.state[p]["momentum_buffer"] = stack[i]
+            st["M"] = stack
+        return st
+
+    # ------------------------------------------------------------------ step
+    @torch.no_grad()
+    def step(self, closure=None):
+        """One Dion step for every matrix of this rank (2 cross-instance collectives per bucket)."""
+        loss = None
+        if closure is not None:
+            with torch.enable_grad():
+                loss = closure()
+        items = self._items()
+        if self._num_steps == 0 and self.inter_group is not None:
+            self._check_alignment(items)
+        for bucket in self._plan(items):
+            self._step_bucket(bucket)
+        self._num_steps += 1
+        if (
+            self.sync_check_interval
+            and self.inter_group is not None
+            and self._num_steps % self.sync_check_interval == 0
+        ):
+            self.check_instances_in_sync()
+        return loss
+
+    def _step_bucket(self, bucket) -> None:
+        device = bucket[0][0][2].device
+        dims = []
+        for run in bucket:
+            m, n = run[0][2].shape
+            dims.append((len(run), m, n, self.rank_for(run[0][2])))
+        p_flat = torch.empty(sum(k * m * r for k, m, _, r in dims), device=device, dtype=self.comm_dtype)
+        r_flat = torch.empty(sum(k * n * r for k, _, n, r in dims), device=device, dtype=self.comm_dtype)
+        storages = [self._run_storage(run) for run in bucket]
+
+        # 1) B = M + G (in place in M), P = B Q
+        offset, p_views = 0, []
+        for run, st, (k, m, n, r) in zip(bucket, storages, dims):
+            with_grad = [(i, it[2].grad) for i, it in enumerate(run) if it[2].grad is not None]
+            if with_grad:
+                torch._foreach_add_([st["M"][i] for i, _ in with_grad], [g for _, g in with_grad])
+            view = p_flat[offset : offset + k * m * r].view(k, m, r)
+            if self.comm_dtype == torch.float32:
+                torch.bmm(st["M"], st["Q"], out=view)
+            else:
+                view.copy_(torch.bmm(st["M"], st["Q"]))
+            p_views.append(view)
+            offset += k * m * r
+        self._all_reduce(p_flat)
+
+        # 2) orthonormalize P; 3) R = B^T P
+        offset, p_orth, r_views = 0, [], []
+        for st, view, (k, m, n, r) in zip(storages, p_views, dims):
+            p_k = orthonormalize(view.float())
+            p_orth.append(p_k)
+            r_view = r_flat[offset : offset + k * n * r].view(k, n, r)
+            if self.comm_dtype == torch.float32:
+                torch.bmm(st["M"].mT, p_k, out=r_view)
+            else:
+                r_view.copy_(torch.bmm(st["M"].mT, p_k))
+            r_views.append(r_view)
+            offset += k * n * r
+        self._all_reduce(r_flat)
+
+        # 4) error feedback, new Q, weight update
+        for run, st, p_k, r_view, (k, m, n, r) in zip(bucket, storages, p_orth, r_views, dims):
+            group = run[0][3]
+            r_k = r_view.float()
+            st["M"].baddbmm_(p_k, r_k.mT, alpha=-(1.0 - group["mu"]) / self.num_instances)
+            norms = r_k.norm(dim=1, keepdim=True)
+            # A zero column (e.g. an expert without tokens in its first steps) keeps its old Q
+            # column; a zero Q column would stay zero for good.
