+            if getattr(ddp_config, "use_layer_wise_param_layout", False) and DP is DistributedDataParallel:
+                # Muon with ZeRO-1: route Muon-managed matrices to shard-aligned buffers and the
+                # rest to DistOpt-style buffers (what megatron/training/training.py does for
+                # --use-layer-wise-param-layout).
+                from megatron.core.optimizer.layer_wise_optimizer import (
+                    LayerWiseDistributedOptimizer,
+                    tag_params_for_buffer_routing,
+                )
+
+                ddp_config.use_distributed_optimizer = True
+                tag_params_for_buffer_routing([model_chunk])
+                compute_full_param_layout = LayerWiseDistributedOptimizer.compute_full_param_layout
+            else:
+                compute_full_param_layout = DistributedOptimizer.compute_full_param_layout
             if ddp_config.use_distributed_optimizer and DP is DistributedDataParallel:
                 all_params = [
                     p for p in model_chunk.parameters() if p.requires_grad
