# Patch: Muon with an exact, reweighted spectrum (optional set "muon-spectral", after muon-zero1;
# launch.sh MUON_SPECTRAL=polar|power:<p>|top:<f>)
#
# Problem:   to test whether Muon's equal treatment of all singular directions matters (9B Dion vs
#            Muon, WORKLOG §7), the update must be computable with other spectral weightings.
# What:      emerging_optimizers.spectral_update(grad, mode, param): exact SVD via the smaller Gram
#            matrix's eigendecomposition (fp64), update U diag(w(s)) V^T rescaled to Frobenius norm
#            sqrt(min(m, n)) (Muon's update RMS), w = 1 (polar), s**p (power), 1 for the top
#            ceil(f min(m, n)) directions else 0 (top, no error feedback). TensorParallelMuon gets
#            spectral_mode / spectral_param (OptimizerConfig muon_spectral_mode / muon_spectral_param,
#            default "ns" = unchanged Newton-Schulz); Muon's momentum, Nesterov, QKV split and shape
#            scaling stay as they are. TP = 1 only. adaptive_muon does not take the new kwargs.
# Porting:   TensorParallelMuon.__init__ and _adaptive_muon_config_to_kwargs in
#            megatron/core/optimizer/emerging_optimizers.py.
#
diff --git a/megatron/core/optimizer/emerging_optimizers.py b/megatron/core/optimizer/emerging_optimizers.py
index 53ac956..c864cb5 100644
--- a/megatron/core/optimizer/emerging_optimizers.py
+++ b/megatron/core/optimizer/emerging_optimizers.py
@@ -9,6 +9,7 @@ To add a new emerging optimizer:
 """
 
 import inspect
+import math
 import logging
 from dataclasses import dataclass, field
 from typing import Any, Callable, Dict, Literal, Optional, get_args
@@ -157,6 +158,55 @@ _EMERGING_OPTIMIZERS: Dict[str, EmergingOptimizerEntry] = {}
 # ===========================================================================
 
 
+@torch.no_grad()
+def spectral_update(grad: torch.Tensor, mode: str, param: float, rel_eps: float = 1e-4) -> torch.Tensor:
+    """Muon update with an exact, reweighted spectrum (optional patch set muon-spectral).
+
+    With G = U diag(s) V^T (from the eigendecomposition of the smaller Gram matrix in fp64: the
+    Gram matrix squares the condition number, which fp32 cannot resolve for gradients with a few
+    strong directions over a noisy bulk), the
+    update is U diag(w(s)) V^T rescaled to the Frobenius norm sqrt(min(m, n)) of a full-rank polar
+    factor, i.e. the RMS of Muon's ideal update, so that modes differ only in how the step is spread
+    over the singular directions:
+
+    - ``polar``: w = 1 (exact Muon; Newton-Schulz approximates it),
+    - ``power``: w = s**param (param = 0: polar; param = 1: the normalized gradient),
+    - ``top``:   w = 1 for the top ceil(param * min(m, n)) directions, 0 for the rest (no error
+      feedback: the tail is dropped).
+
+    Directions with s < rel_eps * max(s) count as numerically zero (w = 0).
+    """
+    g = grad.double()
+    transpose = g.size(0) < g.size(1)
+    if transpose:
+        g = g.t()
+    k = g.size(1)  # min(m, n); g is m x k with m >= k
+    evals, vecs = torch.linalg.eigh(g.t() @ g)  # ascending, k x k
+    s = evals.clamp(min=0).sqrt()
+    smax = s.max()
+    valid = s > rel_eps * smax
+    if mode == "polar":
+        w = torch.ones_like(s)
+    elif mode == "power":
+        w = s.pow(param)
+    elif mode == "top":
+        r = max(1, math.ceil(param * k))
+        w = torch.zeros_like(s)
+        w[-r:] = 1.0
+    else:
+        raise ValueError(f"unknown spectral mode {mode!r}")
+    w = torch.where(valid, w, torch.zeros_like(w))
+    # U diag(w) V^T = G V diag(w / s) V^T
+    coef = torch.where(valid, w / s.clamp(min=torch.finfo(s.dtype).tiny), torch.zeros_like(s))
+    update = g @ ((vecs * coef) @ vecs.t())
+    norm = update.norm()
+    if norm > 0:
+        update = update * (math.sqrt(k) / norm)
+    if transpose:
+        update = update.t()
+    return update.to(grad.dtype)
+
+
 class TensorParallelMuon(OrthogonalizedOptimizer):
     """Tensor Parallel Muon optimizer."""
 
@@ -178,9 +228,13 @@ class TensorParallelMuon(OrthogonalizedOptimizer):
         extra_scale_factor: float = 1.0,
