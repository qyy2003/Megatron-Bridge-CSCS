+                raise ValueError("Muon spectral modes support tensor parallel size 1 only")
+            update = spectral_update(grad, spectral_mode, spectral_param)
+            scale_factor = get_muon_scale_factor(grad.size(-2), grad.size(-1), mode=scale_mode)
+            return update * scale_factor * extra_scale_factor
+
+        if spectral_mode != "ns":
+            scaled_orthogonalize_fn = spectral_update_fn
+
