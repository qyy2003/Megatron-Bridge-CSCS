# Alps variant profile for nvcr.io/nvidia/nemo:26.08.01 (built on NGC PyTorch 26.06).
# Copied into alps-extended-images/Alps-Images/NGC/nemo-26.08.01/ by env/build_image.sbatch.
# Plugin directories removed in the "purge" step: the upstream pytorch-26.06-py3 list plus the
# EFA plugin path of older NeMo images (missing paths are skipped).
# Note: env/build_image.sbatch runs the purge step as a separate image layer first (see there).
REMOVE_HPCX_DIRS="/opt/hpcx/hcoll /opt/hpcx/nccl_rdma_sharp_plugin /opt/hpcx/nccl_spectrum-x_plugin /opt/hpcx/ncclnet_plugin /opt/hpcx/sharp /opt/amazon/ofi-nccl /opt/amazon/aws-ofi-nccl"
