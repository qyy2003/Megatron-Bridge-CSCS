# Pinned versions of everything this project depends on.
# Sourced by env/build_image.sbatch, launch.sh and the data scripts.
# Only stable releases are used; bump them together and re-run the smoke tests.

# Megatron-Bridge (git submodule ./Megatron-Bridge). Its pinned Megatron-LM is the
# nested submodule Megatron-Bridge/3rdparty/Megatron-LM.
MBRIDGE_TAG=v0.6.2
MBRIDGE_COMMIT=c0e164ed2aedac4ad1c877780e2564a19d5d54ec
MLM_COMMIT=a0f793dfa4e776d99a8aa63bed74e0fafc91b0db

# NeMo Framework container that ships Megatron-Bridge v0.6.2 (NeMo FW 26.08 patch 1).
# Multi-arch; the arm64 manifest is used on GH200. CUDA 13.3, PyTorch 2.13, NCCL 2.30.4.
NEMO_TAG=26.08.01

# CSCS Alps network stack (libfabric 2.6.0, NCCL 2.30.7-1 + inspector plugin,
# aws-ofi-nccl v1.20.0, NVSHMEM 3.6.5, OpenMPI 5.0.10) layered on top of NeMo.
# alps6 (tag d7b988a) predates PyTorch-26.06-based images, which NeMo 26.08 is;
# this commit has the identical stack except aws-ofi-nccl moved to its v1.20.0 release.
ALPS_IMAGES_REPO=https://github.com/eth-cscs/alps-extended-images.git
ALPS_IMAGES_COMMIT=6120245197deac43eb329fecdc051d59f0201481
ALPS_REV=alps7-dev

# Name of the squashfs image produced by env/build_image.sbatch (under $IMAGE_DIR).
IMAGE_NAME=nemo-${NEMO_TAG}-alps-mbcscs.sqsh

# Nemotron 3.5 Lightning open-data recipe (data blend) and the Qwen3.5 tokenizer.
NEMOTRON_TAG=v0.2.0
NEMOTRON_COMMIT=ef8c46d439c6853fb454430e3d58725435894ca7
HF_MODEL_ID=Qwen/Qwen3.5-35B-A3B-Base
HF_MODEL_REVISION=0f0813072d2358973511097385626f21fcb6d422
# Qwen3.5 dense models (launch.sh MODEL=0.8b|2b|4b|9b): config + tokenizer only; same tokenizer as above.
HF_DENSE_MODELS="Qwen/Qwen3.5-0.8B-Base@dc7cdfe2ee4154fa7e30f5b51ca41bfa40174e68 Qwen/Qwen3.5-2B-Base@b1485b2fa6dfa1287294f269f5fb618e03d52d7c Qwen/Qwen3.5-4B-Base@1001bb4d826a52d1f399e183466143f4da7b741b Qwen/Qwen3.5-9B-Base@68c46c4b3498877f3ef123c856ecfde50c39f404"
